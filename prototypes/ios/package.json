{
  "name": "@cruxcontrol/ios-prototype",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../web/eslint.config.js src",
    "build": "npm run typecheck && npm --prefix ../../web run build -- --mode ios-prototype",
    "sync": "npm run build && cap sync ios",
    "open": "cap open ios",
    "run": "npm run sync && cap run ios --no-sync"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.4.3",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3"
  }
}
